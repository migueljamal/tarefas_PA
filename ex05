################################################################
# Descrição: Calcula a média de duas notas e avalia o aluno.   #
# Parâmetros de entrada: Duas notas informadas pelo usuário.   #
# Valores de saída: Situação do aluno conforme sua média.      #
# Autor: Miguel dos Santos Ferreira                            #
################################################################

nota1 = float(input("Digite a primeira nota: "))
nota2 = float(input("Digite a segunda nota: "))

media = (nota1 + nota2) / 2

print("Média:", media)

if media == 10:
    print("Aprovado com Distinção")
elif media >= 7:
    print("Aprovado")
else:
    print("Reprovado")
